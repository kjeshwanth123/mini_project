# ============================================================
# Heart Health AI — Environment Configuration (EXAMPLE)
# Copy this file to .env and adjust values for your machine.
# Never commit a real .env file.
# ============================================================

APP_ENV=development
APP_NAME=Heart Health AI
APP_VERSION=1.0.0

DATABASE_URL=sqlite:///./heart_health.db

# Development placeholder only. Change before any shared deployment.
JWT_SECRET=change-this-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

MODEL_PATH=./ml/models/best_model.joblib
PREPROCESSOR_PATH=./ml/models/preprocessor.joblib
MODEL_METADATA_PATH=./ml/models/model_metadata.json

DATASET_PATH=./ml/data/heart_disease.csv

ADMIN_EMAIL=admin@hearthealthai.dev
ADMIN_PASSWORD=HeartHealthAdmin@2026!

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

VITE_API_BASE_URL=http://localhost:8000

DEBUG=true
LOG_LEVEL=INFO

MEDICAL_DISCLAIMER_ENABLED=true
EMERGENCY_WARNING_ENABLED=true

REPORTS_DIR=./reports
UPLOAD_DIR=./uploads

PASSWORD_MIN_LENGTH=8
MAX_LOGIN_ATTEMPTS=5

TESTING=false

# Risk thresholds (probability of predicted heart-disease class)
RISK_LOW_MAX=0.33
RISK_MODERATE_MAX=0.66
